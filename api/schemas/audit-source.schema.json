{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-fee-audit.example/api/schemas/audit-source.schema.json",
  "title": "Audit Source",
  "description": "Metadata and provenance for a user-supplied or explicitly authorized audit source; it never stores credentials.",
  "type": "object",
  "additionalProperties": false,
  "x-value-semantics": {"null": "unavailable, unknown, withheld, or unsupported", "zero": "verified numeric zero", "omitted": "not supplied and never assumed to be zero", "currency": "ISO 4217 code; examples use USD", "percentage": "decimal ratio from 0 through 1 unless stated otherwise"},
  "required": ["schema_version", "source_id", "audit_period", "provider", "source_type", "masked_account_reference", "file_reference", "data_status", "confidence_level", "review_status", "human_review_required", "ingested_at"],
  "properties": {"schema_version": {"type": "string", "const": "1.0.0"}, "source_id": {"type": "string", "pattern": "^source_[a-z0-9_-]+$"}, "audit_period": {"$ref": "audit-period.schema.json"}, "provider": {"type": "string", "enum": ["shopify", "amazon", "stripe", "bank", "google_ads", "meta_ads", "manual_upload", "other"]}, "source_type": {"type": "string", "enum": ["platform_export", "processor_export", "bank_export", "advertising_export", "manual_workpaper", "other"]}, "masked_account_reference": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_*-]+$"}, "file_reference": {"type": "string", "pattern": "^file_[a-z0-9_-]+$", "description": "Internal file reference, not a local path or signed URL."}, "data_status": {"type": "string", "enum": ["received", "processing", "available", "unusable", "withheld", "unsupported"]}, "confidence_level": {"type": "string", "enum": ["high", "medium", "low", "unable_to_determine"]}, "review_status": {"type": "string", "enum": ["unreviewed", "reviewed", "approved", "rejected", "escalated"]}, "human_review_required": {"type": "boolean"}, "ingested_at": {"type": "string", "format": "date-time"}, "source_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}},
  "examples": [{"schema_version": "1.0.0", "source_id": "source_shopify_demo_june", "audit_period": {"schema_version": "1.0.0", "audit_period_id": "audit_period_northstar_2026_06", "audit_id": "audit_northstar_2026", "period_start": "2026-06-01", "period_end": "2026-06-30", "analysis_timezone": "America/New_York", "reporting_currency": "USD", "status": "closed", "created_at": "2026-07-01T09:00:00-04:00", "updated_at": "2026-07-05T16:30:00-04:00", "closed_at": "2026-07-05T16:30:00-04:00"}, "provider": "shopify", "source_type": "platform_export", "masked_account_reference": "shop_*_demo", "file_reference": "file_shopify_demo_june", "data_status": "available", "confidence_level": "high", "review_status": "reviewed", "human_review_required": false, "ingested_at": "2026-07-02T10:00:00-04:00", "source_hash": null}]
}
