{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-fee-audit.example/api/schemas/audit-intake.schema.json",
  "title": "Audit Intake",
  "description": "A consent-aware request to analyze supplied or explicitly authorized ecommerce audit data.",
  "type": "object",
  "additionalProperties": false,
  "x-value-semantics": {"null": "unavailable, unknown, withheld, or unsupported", "zero": "verified numeric zero", "omitted": "not supplied and never assumed to be zero", "currency": "ISO 4217 code; examples use USD", "percentage": "decimal ratio from 0 through 1 unless stated otherwise"},
  "required": ["schema_version", "intake_id", "idempotency_key", "requested_product_id", "audit_period", "requested_outcome", "consent_status", "source_references", "status", "created_at", "human_review_required", "review_status"],
  "$defs": {"product_id": {"type": "string", "enum": ["free_platform_fee_audit_starter", "audit_lab", "margin_control", "guided_margin_recovery", "ecommerce_finance_ops_desk", "partner_agency_license", "one_time_platform_fee_leak_scan", "historical_reconciliation_sprint", "reserve_and_payout_investigation", "sku_margin_reset"]}, "source_reference": {"type": "object", "additionalProperties": false, "required": ["source_reference_id", "provider", "masked_account_reference", "access_method"], "properties": {"source_reference_id": {"type": "string", "pattern": "^source_ref_[a-z0-9_-]+$"}, "provider": {"type": "string", "enum": ["shopify", "amazon", "stripe", "bank", "manual_upload", "other"]}, "masked_account_reference": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_*-]+$", "description": "Masked or provider-generated reference only; never a credential."}, "access_method": {"type": "string", "enum": ["manual_upload", "user_selected_file", "oauth_read", "unsupported"]}}}},
  "properties": {"schema_version": {"type": "string", "const": "1.0.0"}, "intake_id": {"type": "string", "pattern": "^intake_[a-z0-9_-]+$"}, "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128}, "requested_product_id": {"$ref": "#/$defs/product_id"}, "audit_period": {"$ref": "audit-period.schema.json"}, "requested_outcome": {"type": "string", "minLength": 10, "maxLength": 500}, "consent_status": {"type": "string", "enum": ["not_requested", "pending", "granted", "declined", "expired", "revoked"]}, "source_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_reference"}}, "status": {"type": "string", "enum": ["draft", "submitted", "needs_information", "accepted", "declined"]}, "created_at": {"type": "string", "format": "date-time"}, "human_review_required": {"type": "boolean"}, "review_status": {"type": "string", "enum": ["unreviewed", "reviewed", "approved", "rejected", "escalated"]}},
  "examples": [{"schema_version": "1.0.0", "intake_id": "intake_northstar_2026_06", "idempotency_key": "idem_intake_northstar_2026_06", "requested_product_id": "audit_lab", "audit_period": {"schema_version": "1.0.0", "audit_period_id": "audit_period_northstar_2026_06", "audit_id": "audit_northstar_2026", "period_start": "2026-06-01", "period_end": "2026-06-30", "analysis_timezone": "America/New_York", "reporting_currency": "USD", "status": "closed", "created_at": "2026-07-01T09:00:00-04:00", "updated_at": "2026-07-05T16:30:00-04:00", "closed_at": "2026-07-05T16:30:00-04:00"}, "requested_outcome": "Reconcile supplied payouts and identify documented exceptions.", "consent_status": "granted", "source_references": [{"source_reference_id": "source_ref_shopify_demo", "provider": "shopify", "masked_account_reference": "shop_*_demo", "access_method": "manual_upload"}], "status": "submitted", "created_at": "2026-07-01T09:15:00-04:00", "human_review_required": false, "review_status": "reviewed"}]
}
