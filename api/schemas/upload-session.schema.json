{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-fee-audit.example/api/schemas/upload-session.schema.json",
  "title": "Upload Session",
  "description": "A time-bounded, consent-aware request to upload an authorized audit source. It contains no signed URL, credential, or source payload.",
  "type": "object",
  "additionalProperties": false,
  "x-value-semantics": {"null": "unavailable, unknown, withheld, or unsupported", "zero": "verified numeric zero", "omitted": "not supplied and never assumed to be zero", "currency": "ISO 4217 code; examples use USD", "percentage": "decimal ratio from 0 through 1 unless stated otherwise"},
  "required": ["schema_version", "upload_session_id", "intake_id", "idempotency_key", "status", "consent_status", "accepted_content_types", "max_bytes", "created_at", "expires_at", "human_review_required"],
  "properties": {"schema_version": {"type": "string", "const": "1.0.0"}, "upload_session_id": {"type": "string", "pattern": "^upload_session_[a-z0-9_-]+$"}, "intake_id": {"type": "string", "pattern": "^intake_[a-z0-9_-]+$", "description": "Reference to the Audit Intake that authorized this request."}, "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128}, "status": {"type": "string", "enum": ["requested", "active", "completed", "expired", "cancelled", "rejected"]}, "consent_status": {"type": "string", "enum": ["not_requested", "pending", "granted", "declined", "expired", "revoked"]}, "accepted_content_types": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["text/csv", "application/json", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"]}}, "max_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600, "description": "Maximum accepted payload size in bytes; 0 is not valid because it would deny every upload."}, "created_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": ["string", "null"], "format": "date-time"}, "human_review_required": {"type": "boolean"}, "source_reference_id": {"type": ["string", "null"], "pattern": "^source_ref_[a-z0-9_-]+$"}},
  "examples": [{"schema_version": "1.0.0", "upload_session_id": "upload_session_northstar_payouts", "intake_id": "intake_northstar_2026_06", "idempotency_key": "idem_upload_northstar_payouts", "status": "active", "consent_status": "granted", "accepted_content_types": ["text/csv"], "max_bytes": 10485760, "created_at": "2026-07-01T09:30:00-04:00", "expires_at": "2026-07-01T10:30:00-04:00", "completed_at": null, "human_review_required": false, "source_reference_id": "source_ref_shopify_demo"}]
}
