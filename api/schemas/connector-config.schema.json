{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-fee-audit.example/api/schemas/connector-config.schema.json",
  "title": "Connector Configuration",
  "description": "A credential-free configuration record for a permitted data connector; secrets remain server-side and are never represented here.",
  "type": "object",
  "additionalProperties": false,
  "x-value-semantics": {"null": "unavailable, unknown, withheld, or unsupported", "zero": "verified numeric zero", "omitted": "not supplied and never assumed to be zero", "currency": "ISO 4217 code; examples use USD", "percentage": "decimal ratio from 0 through 1 unless stated otherwise"},
  "required": ["schema_version", "connector_config_id", "subject_reference", "provider", "access_mode", "status", "consent_status", "entitled_product_id", "created_at", "updated_at", "human_review_required"],
  "$defs": {"product_id": {"type": "string", "enum": ["free_platform_fee_audit_starter", "audit_lab", "margin_control", "guided_margin_recovery", "ecommerce_finance_ops_desk", "partner_agency_license", "one_time_platform_fee_leak_scan", "historical_reconciliation_sprint", "reserve_and_payout_investigation", "sku_margin_reset"]}},
  "properties": {"schema_version": {"type": "string", "const": "1.0.0"}, "connector_config_id": {"type": "string", "pattern": "^connector_config_[a-z0-9_-]+$"}, "subject_reference": {"type": "string", "pattern": "^(organization|partner)_[a-z0-9_-]+$"}, "provider": {"type": "string", "enum": ["shopify", "amazon_seller_central", "stripe", "google_drive", "google_sheets", "manual_upload", "other"]}, "access_mode": {"type": "string", "enum": ["manual_upload", "user_selected_file", "oauth_read", "oauth_write", "webhook", "future", "unsupported"]}, "status": {"type": "string", "enum": ["not_configured", "pending_consent", "connected", "disabled", "error", "unsupported"]}, "consent_status": {"type": "string", "enum": ["not_requested", "pending", "granted", "declined", "expired", "revoked"]}, "entitled_product_id": {"$ref": "#/$defs/product_id"}, "masked_account_reference": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_*-]+$"}, "approved_scopes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9._-]+$"}}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "human_review_required": {"type": "boolean"}},
  "examples": [{"schema_version": "1.0.0", "connector_config_id": "connector_config_northstar_drive", "subject_reference": "organization_northstar_demo", "provider": "google_drive", "access_mode": "oauth_read", "status": "pending_consent", "consent_status": "pending", "entitled_product_id": "audit_lab", "masked_account_reference": "drive_*_demo", "approved_scopes": ["drive.readonly"], "created_at": "2026-07-03T10:00:00Z", "updated_at": "2026-07-03T10:00:00Z", "human_review_required": false}]
}
