{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-fee-audit.example/api/schemas/event-envelope.schema.json",
  "title": "Event Envelope",
  "description": "A durable, idempotent event wrapper for internal processing or approved destinations; an event alone never authorizes an external write.",
  "type": "object",
  "additionalProperties": false,
  "x-value-semantics": {"null": "unavailable, unknown, withheld, or unsupported", "zero": "verified numeric zero", "omitted": "not supplied and never assumed to be zero", "currency": "ISO 4217 code; examples use USD", "percentage": "decimal ratio from 0 through 1 unless stated otherwise"},
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "producer", "idempotency_key", "payload", "delivery_status", "human_review_required"],
  "properties": {"schema_version": {"type": "string", "const": "1.0.0"}, "event_id": {"type": "string", "pattern": "^event_[a-z0-9_-]+$"}, "event_type": {"type": "string", "enum": ["audit.created", "audit.files_requested", "audit.files_received", "audit.data_gap_detected", "audit.reconciliation_completed", "audit.fee_leakage_detected", "audit.reserve_alert", "audit.negative_sku_margin", "audit.cash_timing_risk", "audit.ready_for_review", "audit.approved", "audit.delivered", "dispute.case_created", "funding.readiness_completed", "subscription.entitlement_changed", "subscription.upgrade_recommended", "connector.sync_completed", "connector.sync_failed"]}, "occurred_at": {"type": "string", "format": "date-time"}, "producer": {"type": "string", "pattern": "^[a-z0-9_-]+$"}, "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128}, "payload": {"type": "object", "additionalProperties": false, "required": ["audit_id", "reference_id", "confidence_level"], "properties": {"audit_id": {"type": "string", "pattern": "^audit_[a-z0-9_-]+$"}, "reference_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"}, "confidence_level": {"type": "string", "enum": ["high", "medium", "low", "unable_to_determine"]}}}, "delivery_status": {"type": "string", "enum": ["pending", "delivered", "failed", "dead_lettered"]}, "human_review_required": {"type": "boolean"}, "consent_status": {"type": ["string", "null"], "enum": ["not_requested", "pending", "granted", "declined", "expired", "revoked", null]}},
  "examples": [{"schema_version": "1.0.0", "event_id": "event_northstar_reconciliation", "event_type": "audit.reconciliation_completed", "occurred_at": "2026-07-03T14:00:00Z", "producer": "audit_processor", "idempotency_key": "idem_event_northstar_reconciliation", "payload": {"audit_id": "audit_northstar_2026", "reference_id": "job_northstar_reconcile_01", "confidence_level": "medium"}, "delivery_status": "delivered", "human_review_required": true, "consent_status": "granted"}]
}
