{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-fee-audit.example/api/schemas/audit-finding.schema.json",
  "title": "Audit Finding",
  "description": "A documented audit observation with evidence, confidence, review state, and no implied financial conclusion.",
  "type": "object",
  "additionalProperties": false,
  "x-value-semantics": {"null": "unavailable, unknown, withheld, or unsupported", "zero": "verified numeric zero", "omitted": "not supplied and never assumed to be zero", "currency": "ISO 4217 code; examples use USD", "percentage": "decimal ratio from 0 through 1 unless stated otherwise"},
  "required": ["schema_version", "finding_id", "audit_id", "source", "finding_type", "summary", "financial_impact", "confidence_level", "review_status", "human_review_required", "status", "created_at"],
  "properties": {"schema_version": {"type": "string", "const": "1.0.0"}, "finding_id": {"type": "string", "pattern": "^finding_[a-z0-9_-]+$"}, "audit_id": {"type": "string", "pattern": "^audit_[a-z0-9_-]+$"}, "source": {"$ref": "audit-source.schema.json"}, "finding_type": {"type": "string", "enum": ["payout_variance", "fee_variance", "reserve_hold", "cash_timing", "sku_margin", "data_gap", "other"]}, "summary": {"type": "string", "minLength": 10, "maxLength": 1000}, "financial_impact": {"type": "object", "additionalProperties": false, "required": ["amount", "currency", "basis"], "properties": {"amount": {"type": ["number", "null"], "description": "Signed verified amount in currency units; 0 means a verified zero and null means unavailable."}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "basis": {"type": "string", "enum": ["observed", "calculated", "estimated", "unavailable"]}}}, "confidence_level": {"type": "string", "enum": ["high", "medium", "low", "unable_to_determine"]}, "review_status": {"type": "string", "enum": ["unreviewed", "reviewed", "approved", "rejected", "escalated"]}, "human_review_required": {"type": "boolean"}, "status": {"type": "string", "enum": ["open", "investigating", "awaiting_data", "resolved", "waived", "escalated"]}, "created_at": {"type": "string", "format": "date-time"}, "source_record_references": {"type": "array", "items": {"type": "string", "pattern": "^record_[a-z0-9_-]+$"}}},
  "examples": [{"schema_version": "1.0.0", "finding_id": "finding_northstar_payout_variance", "audit_id": "audit_northstar_2026", "source": {"schema_version": "1.0.0", "source_id": "source_shopify_demo_june", "audit_period": {"schema_version": "1.0.0", "audit_period_id": "audit_period_northstar_2026_06", "audit_id": "audit_northstar_2026", "period_start": "2026-06-01", "period_end": "2026-06-30", "analysis_timezone": "America/New_York", "reporting_currency": "USD", "status": "closed", "created_at": "2026-07-01T09:00:00-04:00", "updated_at": "2026-07-05T16:30:00-04:00", "closed_at": "2026-07-05T16:30:00-04:00"}, "provider": "shopify", "source_type": "platform_export", "masked_account_reference": "shop_*_demo", "file_reference": "file_shopify_demo_june", "data_status": "available", "confidence_level": "high", "review_status": "reviewed", "human_review_required": false, "ingested_at": "2026-07-02T10:00:00-04:00", "source_hash": null}, "finding_type": "payout_variance", "summary": "A fictional payout remains unmatched to the supplied bank export and needs review.", "financial_impact": {"amount": 0, "currency": "USD", "basis": "observed"}, "confidence_level": "medium", "review_status": "unreviewed", "human_review_required": true, "status": "investigating", "created_at": "2026-07-03T14:00:00-04:00", "source_record_references": ["record_payout_demo_01"]}]
}
