{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-fee-audit.example/api/schemas/service-order.schema.json",
  "title": "Service Order",
  "description": "A scope and fulfillment record for a canonical product or add-on. It is not a payment instruction, funding application, or guarantee of outcome.",
  "type": "object",
  "additionalProperties": false,
  "x-value-semantics": {"null": "unavailable, unknown, withheld, or unsupported", "zero": "verified numeric zero", "omitted": "not supplied and never assumed to be zero", "currency": "ISO 4217 code; examples use USD", "percentage": "decimal ratio from 0 through 1 unless stated otherwise"},
  "required": ["schema_version", "service_order_id", "subject_reference", "product_id", "order_status", "pricing_status", "scope_status", "created_at", "human_review_required", "review_status"],
  "$defs": {"product_id": {"type": "string", "enum": ["free_platform_fee_audit_starter", "audit_lab", "margin_control", "guided_margin_recovery", "ecommerce_finance_ops_desk", "partner_agency_license", "one_time_platform_fee_leak_scan", "historical_reconciliation_sprint", "reserve_and_payout_investigation", "sku_margin_reset"]}},
  "properties": {"schema_version": {"type": "string", "const": "1.0.0"}, "service_order_id": {"type": "string", "pattern": "^service_order_[a-z0-9_-]+$"}, "subject_reference": {"type": "string", "pattern": "^(organization|partner)_[a-z0-9_-]+$"}, "product_id": {"$ref": "#/$defs/product_id"}, "order_status": {"type": "string", "enum": ["draft", "pending_review", "approved", "active", "completed", "cancelled", "declined"]}, "pricing_status": {"type": "string", "enum": ["approved", "provisional", "founding-member", "placeholder"], "description": "Commercial status only; it is not a guarantee or invoice authorization."}, "scope_status": {"type": "string", "enum": ["unscoped", "scoped", "awaiting_information", "accepted", "out_of_scope"]}, "price": {"type": ["object", "null"], "description": "A documented price only when approved for the order; null means unavailable or not yet approved.", "additionalProperties": false, "required": ["amount", "currency", "frequency"], "properties": {"amount": {"type": "number", "minimum": 0, "description": "Currency-unit amount; 0 is a verified zero."}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "frequency": {"type": "string", "enum": ["one_time", "monthly", "annual"]}}}, "created_at": {"type": "string", "format": "date-time"}, "human_review_required": {"type": "boolean"}, "review_status": {"type": "string", "enum": ["unreviewed", "reviewed", "approved", "rejected", "escalated"]}},
  "examples": [{"schema_version": "1.0.0", "service_order_id": "service_order_northstar_audit_lab", "subject_reference": "organization_northstar_demo", "product_id": "audit_lab", "order_status": "pending_review", "pricing_status": "provisional", "scope_status": "scoped", "price": {"amount": 19, "currency": "USD", "frequency": "monthly"}, "created_at": "2026-07-01T09:00:00-04:00", "human_review_required": true, "review_status": "reviewed"}]
}
