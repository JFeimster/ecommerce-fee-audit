{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecommerce-fee-audit.example/api/schemas/audit-job.schema.json",
  "title": "Audit Job",
  "description": "An idempotent local or server-side audit-processing job; it does not authorize an external write.",
  "type": "object",
  "additionalProperties": false,
  "x-value-semantics": {"null": "unavailable, unknown, withheld, or unsupported", "zero": "verified numeric zero", "omitted": "not supplied and never assumed to be zero", "currency": "ISO 4217 code; examples use USD", "percentage": "decimal ratio from 0 through 1 unless stated otherwise"},
  "required": ["schema_version", "job_id", "audit_id", "intake_id", "idempotency_key", "job_type", "status", "requested_at", "human_review_required", "review_status", "audit_trail"],
  "properties": {"schema_version": {"type": "string", "const": "1.0.0"}, "job_id": {"type": "string", "pattern": "^job_[a-z0-9_-]+$"}, "audit_id": {"type": "string", "pattern": "^audit_[a-z0-9_-]+$"}, "intake_id": {"type": "string", "pattern": "^intake_[a-z0-9_-]+$", "description": "Reference to an Audit Intake; no credentials are copied into this job."}, "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128}, "job_type": {"type": "string", "enum": ["normalize_sources", "reconcile_payouts", "calculate_margin", "generate_report", "validate_export"]}, "status": {"type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled", "blocked"]}, "requested_at": {"type": "string", "format": "date-time"}, "started_at": {"type": ["string", "null"], "format": "date-time"}, "completed_at": {"type": ["string", "null"], "format": "date-time"}, "result_reference": {"type": ["string", "null"], "pattern": "^(report|export|job_result)_[a-z0-9_-]+$"}, "error_code": {"type": ["string", "null"], "pattern": "^[a-z0-9_]+$"}, "human_review_required": {"type": "boolean"}, "review_status": {"type": "string", "enum": ["unreviewed", "reviewed", "approved", "rejected", "escalated"]}, "audit_trail": {"type": "object", "additionalProperties": false, "required": ["created_at", "updated_at", "created_by"], "properties": {"created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string", "pattern": "^(system|user|partner)_[a-z0-9_-]+$"}}}},
  "examples": [{"schema_version": "1.0.0", "job_id": "job_northstar_reconcile_01", "audit_id": "audit_northstar_2026", "intake_id": "intake_northstar_2026_06", "idempotency_key": "idem_job_northstar_reconcile_01", "job_type": "reconcile_payouts", "status": "succeeded", "requested_at": "2026-07-02T09:00:00-04:00", "started_at": "2026-07-02T09:01:00-04:00", "completed_at": "2026-07-02T09:03:00-04:00", "result_reference": "job_result_northstar_01", "error_code": null, "human_review_required": false, "review_status": "reviewed", "audit_trail": {"created_at": "2026-07-02T09:00:00-04:00", "updated_at": "2026-07-02T09:03:00-04:00", "created_by": "system_fixture"}}]
}
