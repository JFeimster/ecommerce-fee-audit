# Public example configuration only. Never place live secrets in this file.

SITE_NAME=AI Platform Fee Audit Copilot
SITE_URL=https://ecommerce-fee-audit.vercel.app
SITE_ENV=development
SITE_VERSION=1.0.0

PUBLIC_API_BASE=http://localhost:3000/api

FEATURE_EXPORT=true
FEATURE_WIDGET=true
FEATURE_ANALYTICS=false

GITHUB_REPOSITORY=JFeimster/ecommerce-fee-audit
GITHUB_OWNER=JFeimster
GITHUB_REPO=ecommerce-fee-audit
DEFAULT_BRANCH=main

# Configure these only in GitHub Environment secrets or Vercel Environment Variables.
# Do not paste real values into this tracked file.
VERCEL_DEPLOY_HOOK_URL=
GITHUB_WEBHOOK_SECRET=

GITHUB_WEBHOOK_ALLOWED_EVENTS=push,pull_request,workflow_run,release,issues,issue_comment
GITHUB_WEBHOOK_ENABLED=false
WEBHOOK_LOG_LEVEL=info

MOONSHINE_API=
MOONSHINE_WEBHOOK=
