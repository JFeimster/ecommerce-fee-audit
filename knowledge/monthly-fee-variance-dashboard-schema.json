{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "metadata": {
    "title": "Monthly Fee Variance Dashboard Schema",
    "filename": "monthly-fee-variance-dashboard-schema.json",
    "version": "1.0.0",
    "status": "production-ready",
    "last_updated": "2026-07-27",
    "default_example_currency": "USD",
    "purpose": "Chart-ready KPI, variance, alert, filter, and drill-down specification for platform-fee and cash-timing dashboards.",
    "related_files": [
      "normalized-platform-fee-taxonomy.yaml",
      "master-transaction-schema.json",
      "reconciliation-and-calculation-rules.md",
      "sku-contribution-margin-scorecard.csv",
      "reserve-and-hold-tracker.csv"
    ]
  },
  "conventions": {
    "date_format": "ISO 8601",
    "period_format": "YYYY-MM",
    "currency_format": "ISO 4217 uppercase",
    "amount_sign": "Dashboard expense and exposure magnitudes are non-negative; signed source records remain available in drill-down.",
    "ratio_storage": "Decimal ratio; 0.125 means 12.5%.",
    "rounding": "Store unrounded values; display currency to currency exponent and ratios to 2 percentage points.",
    "null_rule": "null means unavailable or unsupported; zero means confirmed zero.",
    "comparison_rule": "Compare like platform, store, channel, fee category, currency, period length, and data coverage."
  },
