  "kpi_definitions": [
    {
      "kpi_code": "gross_sales",
      "display_name": "Gross sales",
      "definition": "Merchandise sales before discounts, refunds, taxes, duties, tips, and shipping income.",
      "formula": "sum(gross_sales)",
      "unit": "currency",
      "direction": "context",
      "required_fields": [
        "gross_sales",
        "currency"
      ],
      "alert_logic": "informational_only"
    },
    {
      "kpi_code": "net_sales",
      "display_name": "Net sales",
      "definition": "Gross sales less merchant-funded discounts and refunds.",
      "formula": "gross_sales - discounts - refunds",
      "unit": "currency",
      "direction": "higher_is_generally_better",
      "required_fields": [
        "gross_sales",
        "discounts",
        "refunds",
        "currency"
      ],
      "alert_logic": "compare_to_prior_and_budget"
    },
    {
      "kpi_code": "total_fees",
      "display_name": "Total fees",
      "definition": "Sum of processing, marketplace, fulfillment, storage, advertising, currency, international, instant-payout, shipping-label, and supported fee categories. Financing principal and reserve holds are excluded.",
      "formula": "sum(fee_categories)",
      "unit": "currency",
      "direction": "lower_is_generally_better",
      "required_fields": [
        "fee_category",
        "total_fees",
        "currency"
      ],
      "alert_logic": "fee_variance_thresholds"
    },
    {
      "kpi_code": "effective_fee_rate",
      "display_name": "Effective fee rate",
      "definition": "Total operating platform fees divided by gross sales.",
      "formula": "total_fees / gross_sales",
      "unit": "ratio",
      "direction": "lower_is_generally_better",
      "required_fields": [
        "total_fees",
        "gross_sales"
      ],
      "alert_logic": "ratio_variance_thresholds"
    },
    {
      "kpi_code": "refund_rate",
      "display_name": "Refund rate",
      "definition": "Refund magnitude divided by gross sales.",
      "formula": "refunds / gross_sales",
      "unit": "ratio",
      "direction": "lower_is_generally_better",
      "required_fields": [
        "refunds",
        "gross_sales"
      ],
      "alert_logic": "ratio_variance_thresholds"
    },
    {
      "kpi_code": "chargeback_rate",
      "display_name": "Chargeback rate",
      "definition": "Chargeback amount divided by gross sales.",
      "formula": "chargebacks / gross_sales",
      "unit": "ratio",
      "direction": "lower_is_generally_better",
      "required_fields": [
        "chargebacks",
        "gross_sales"
      ],
      "alert_logic": "ratio_variance_thresholds"
    },
    {
      "kpi_code": "advertising_ratio",
      "display_name": "Advertising-to-sales ratio",
      "definition": "Advertising cost divided by net sales.",
      "formula": "advertising_cost / net_sales",
      "unit": "ratio",
      "direction": "lower_is_context_dependent",
      "required_fields": [
        "advertising_cost",
        "net_sales"
      ],
      "alert_logic": "ratio_variance_thresholds"
    },
    {
      "kpi_code": "reserve_exposure",
      "display_name": "Reserve exposure ratio",
      "definition": "Closing restricted reserve and hold balance divided by trailing gross sales for the approved window.",
      "formula": "reserve_balance / trailing_gross_sales",
      "unit": "ratio",
      "direction": "lower_is_generally_better",
      "required_fields": [
        "reserve_balance",
        "trailing_gross_sales"
      ],
      "alert_logic": "reserve_thresholds"
    },
    {
      "kpi_code": "financing_deductions",
      "display_name": "Financing deductions",
      "definition": "Cash deducted for financing remittances during the period.",
      "formula": "sum(financing_deductions)",
      "unit": "currency",
      "direction": "lower_is_context_dependent",
      "required_fields": [
        "financing_deductions",
        "currency"
      ],
      "alert_logic": "compare_to_cash_and_prior"
    },
    {
      "kpi_code": "net_payout",
      "display_name": "Net payout",
      "definition": "Total payouts transferred from platform or processor balance during the period.",
      "formula": "sum(net_payout)",
      "unit": "currency",
      "direction": "context",
      "required_fields": [
        "net_payout",
        "currency"
      ],
      "alert_logic": "reconciliation_control"
    },
    {
      "kpi_code": "payout_delay_days",
      "display_name": "Payout delay",
      "definition": "Calendar days from payout initiation to bank posting, reported separately from settlement delay.",
      "formula": "bank_posted_date - payout_initiated_date",
      "unit": "days",
      "direction": "lower_is_generally_better",
      "required_fields": [
        "payout_initiated_date",
        "bank_posted_date"
      ],
      "alert_logic": "timing_thresholds"
    },
    {
      "kpi_code": "unmatched_amount",
      "display_name": "Unmatched amount",
      "definition": "Absolute value of material payout, settlement, or bank amounts not matched within approved rules.",
      "formula": "sum(abs(unmatched_amount))",
      "unit": "currency",
      "direction": "lower_is_better",
      "required_fields": [
        "unmatched_amount",
        "currency"
      ],
      "alert_logic": "materiality_thresholds"
    },
    {
      "kpi_code": "unclassified_amount",
      "display_name": "Unclassified amount",
      "definition": "Absolute value of transactions classified as UNCLASSIFIED.",
      "formula": "sum(abs(unclassified_amount))",
      "unit": "currency",
      "direction": "lower_is_better",
      "required_fields": [
        "unclassified_amount",
        "currency"
      ],
      "alert_logic": "unclassified_thresholds"
    }
  ],
  "variance_formulas": {
    "absolute_variance": "current_period - prior_period",
    "percentage_variance": "(current_period - prior_period) / abs(prior_period)",
    "benchmark_variance": "current_period - budget_or_benchmark",
    "percentage_variance_zero_prior_rule": "Return null when prior_period is zero; show new_activity flag instead of infinity.",
    "favorable_direction_rule": "Store raw mathematical variance; derive favorable/unfavorable using each KPI direction."
  },
  "alert_thresholds": {
    "operational_defaults_notice": "These are configurable operator defaults, not accounting standards or platform guarantees. User-approved thresholds override them.",
    "materiality": {
      "currency_floor": 10.0,
      "gross_sales_ratio": 0.001,
      "formula": "max(currency_floor, gross_sales_ratio × abs(gross_sales))"
    },
    "fee_variance_thresholds": [
      {
        "status": "none",
        "condition": "abs(percentage_variance) < 0.05 and absolute_variance < materiality"
      },
      {
        "status": "watch",
        "condition": "percentage_variance >= 0.05 or absolute_variance >= materiality"
      },
      {
        "status": "warning",
        "condition": "percentage_variance >= 0.10 and absolute_variance >= materiality"
      },
      {
        "status": "critical",
        "condition": "percentage_variance >= 0.20 and absolute_variance >= 5 × materiality"
      }
    ],
    "ratio_variance_thresholds": [
      {
        "status": "watch",
        "condition": "current ratio increases by at least 0.01 absolute"
      },
      {
        "status": "warning",
        "condition": "current ratio increases by at least 0.03 absolute"
      },
      {
        "status": "critical",
        "condition": "current ratio increases by at least 0.05 absolute and related amount exceeds materiality"
      }
    ],
    "reserve_thresholds": [
      {
        "status": "watch",
        "condition": "reserve_exposure >= 0.05"
      },
      {
        "status": "warning",
        "condition": "reserve_exposure >= 0.10"
      },
      {
        "status": "critical",
        "condition": "reserve_exposure >= 0.20 or release date unknown and restricted amount is material"
      }
    ],
    "timing_thresholds": [
      {
        "status": "watch",
        "condition": "payout_delay exceeds verified normal by 1 day"
      },
      {
        "status": "warning",
        "condition": "payout_delay exceeds verified normal by 3 days"
      },
      {
        "status": "critical",
        "condition": "payout is missing, failed, held, or exceeds verified normal by 7 days"
      }
    ],
    "unclassified_thresholds": [
      {
        "status": "watch",
        "condition": "unclassified_share > 0 and <= 0.05"
      },
      {
        "status": "warning",
        "condition": "unclassified_share > 0.05 and <= 0.20"
      },
      {
        "status": "data_gap",
        "condition": "unclassified_share > 0.20"
      }
    ],
    "override_rules": [
      "Any material unmatched payout is at least warning.",
      "A missing core source file produces data_gap regardless of numeric variance.",
      "Low or unable_to_determine confidence can raise alert status but cannot lower it.",
      "Critical tax, legal, accounting, dispute, or funding conclusions require human_review_required."
    ]
  },
  "severity_rules": {
    "none": "Within approved thresholds and no material data gap.",
    "watch": "Small variance or emerging trend; verify next period.",
    "warning": "Material adverse variance or unresolved reconciliation item.",
    "critical": "Large cash, fee, reserve, or timing exposure requiring prompt review.",
    "data_gap": "Required evidence is missing or more than 20% of value is unclassified.",
    "human_review_required": "The finding needs qualified approval or materially ambiguous classification."
  },
