      "UNCLASSIFIED"
    ]
  },
  "test_cases": [
    {
      "test_id": "QA-001",
      "scenario": "Complete Shopify reconciliation",
      "input_records": [
        {
          "record_id": "sh-sale-001",
          "platform": "shopify",
          "transaction_at": "2026-06-28T10:00:00-04:00",
          "currency": "USD",
          "source_amount": 1000,
          "source_label": "sale",
          "order_id": "ord-fic-001"
        },
        {
          "record_id": "sh-fee-001",
          "platform": "shopify",
          "transaction_at": "2026-06-28T10:00:01-04:00",
          "currency": "USD",
          "source_amount": -30,
          "source_label": "processing_fee",
          "payout_id": "po-fic-001"
        },
        {
          "record_id": "sh-payout-001",
          "platform": "shopify",
          "transaction_at": "2026-06-28T18:00:00-04:00",
          "currency": "USD",
          "source_amount": -970,
          "source_label": "payout",
          "payout_id": "po-fic-001"
        },
        {
          "record_id": "bank-dep-001",
          "platform": "bank",
          "transaction_at": "2026-06-30T09:00:00-04:00",
          "currency": "USD",
          "source_amount": 970,
          "source_label": "SHOPIFY DEPOSIT",
          "bank_transaction_id": "bank-fic-001",
          "payout_id": "po-fic-001"
        }
      ],
      "expected_classification": [
        {
          "record_ids": [
            "sh-sale-001"
          ],
          "taxonomy_code": "REV_GROSS_SALES"
        },
        {
          "record_ids": [
            "sh-fee-001"
          ],
          "taxonomy_code": "FEE_PROCESSING"
        },
        {
          "record_ids": [
            "sh-payout-001"
          ],
          "taxonomy_code": "TRF_PAYOUT"
        },
        {
          "record_ids": [
            "bank-dep-001"
          ],
          "taxonomy_code": "TRF_BANK_DEPOSIT"
        }
      ],
      "expected_calculations": [
        {
          "calculation_code": "expected_payout",
          "formula": "1000 - 30",
          "expected_value": 970,
          "tolerance": 0.01,
          "currency": "USD"
        },
        {
          "calculation_code": "bank_variance",
          "formula": "970 - 970",
          "expected_value": 0,
          "tolerance": 0.01,
          "currency": "USD"
        },
        {
          "calculation_code": "effective_fee_rate",
          "formula": "30 / 1000",
          "expected_value": 0.03,
          "tolerance": 1e-06
        }
      ],
      "expected_reconciliation_status": "matched",
      "expected_confidence": "High",
      "expected_warnings": [],
      "expected_user_facing_response": "The $970 Shopify payout matches the $970 bank deposit. Processing fees total $30, or 3.00% of gross sales.",
      "expected_escalation": {
        "required": false,
        "reason": null,
        "target_role": null
      },
      "pass_criteria": [
        "All four records receive the expected taxonomy code.",
        "Expected payout equals $970.00.",
        "Bank variance equals $0.00.",
        "No sales or transfers are double-counted."
      ]
    },
    {
      "test_id": "QA-002",
      "scenario": "Shopify refund mismatch",
      "input_records": [
        {
          "record_id": "sh-refund-001",
          "platform": "shopify",
          "transaction_at": "2026-06-15T11:00:00-04:00",
          "currency": "USD",
          "source_amount": -120,
          "source_label": "refund",
          "order_id": "ord-fic-002"
        },
        {
          "record_id": "sh-payout-refund-001",
          "platform": "shopify",
          "transaction_at": "2026-06-16T18:00:00-04:00",
          "currency": "USD",
          "source_amount": -100,
          "source_label": "refund_adjustment",
          "payout_id": "po-fic-002"
        }
      ],
      "expected_classification": [
        {
          "record_ids": [
            "sh-refund-001"
          ],
          "taxonomy_code": "REV_REFUND"
        },
        {
          "record_ids": [
            "sh-payout-refund-001"
          ],
          "taxonomy_code": "REV_REFUND",
          "note": "Settlement representation; link to original and do not count twice."
        }
      ],
      "expected_calculations": [
        {
          "calculation_code": "refund_variance",
          "formula": "abs(120) - abs(100)",
          "expected_value": 20,
          "tolerance": 0.01,
          "currency": "USD"
        }
      ],
      "expected_reconciliation_status": "unmatched",
      "expected_confidence": "Medium",
      "expected_warnings": [
        "A $20 refund difference remains unresolved.",
        "The settlement line may be a partial refund or timing difference."
      ],
      "expected_user_facing_response": "The supplied records show a $120 refund but only a $100 payout adjustment, leaving a $20 unresolved difference. Review the order refund detail and settlement timing.",
      "expected_escalation": {
        "required": true,
        "reason": "Material refund mismatch requires source review.",
        "target_role": "finance operator"
      },
      "pass_criteria": [
        "Variance equals $20.00.",
        "The two records are linked rather than double-counted.",
        "Status is unmatched and confidence is Medium."
      ]
    },
    {
      "test_id": "QA-003",
      "scenario": "Shopify Capital deduction",
      "input_records": [
        {
          "record_id": "sh-sale-003",
          "platform": "shopify",
          "transaction_at": "2026-06-20T10:00:00-04:00",
          "currency": "USD",
          "source_amount": 2000,
          "source_label": "sales"
        },
        {
          "record_id": "sh-cap-003",
          "platform": "shopify",
          "transaction_at": "2026-06-20T18:00:00-04:00",
          "currency": "USD",
          "source_amount": -220,
          "source_label": "Shopify Capital remittance",
          "payout_id": "po-fic-003"
        },
        {
          "record_id": "sh-payout-003",
          "platform": "shopify",
          "transaction_at": "2026-06-20T18:00:01-04:00",
          "currency": "USD",
          "source_amount": -1780,
          "source_label": "payout",
          "payout_id": "po-fic-003"
        }
      ],
      "expected_classification": [
        {
          "record_ids": [
            "sh-sale-003"
          ],
          "taxonomy_code": "REV_GROSS_SALES"
        },
        {
          "record_ids": [
            "sh-cap-003"
          ],
          "taxonomy_code": "FIN_REMITTANCE"
        },
        {
          "record_ids": [
            "sh-payout-003"
          ],
          "taxonomy_code": "TRF_PAYOUT"
        }
      ],
      "expected_calculations": [
        {
          "calculation_code": "expected_payout",
          "formula": "2000 - 220",
          "expected_value": 1780,
          "tolerance": 0.01,
          "currency": "USD"
        },
        {
          "calculation_code": "remittance_rate",
          "formula": "220 / 2000",
          "expected_value": 0.11,
          "tolerance": 1e-06
        }
      ],
      "expected_reconciliation_status": "partial",
      "expected_confidence": "Medium",
      "expected_warnings": [
        "The principal-versus-financing-cost split is unavailable and must not be inferred."
      ],
      "expected_user_facing_response": "The $220 Shopify Capital remittance explains the $1,780 payout. It is classified as financing remittance, not a platform fee; principal and financing-cost treatment requires the agreement or ledger detail.",
      "expected_escalation": {
        "required": true,
        "reason": "Accounting treatment and agreement terms require human review.",
        "target_role": "accountant or finance operator"
      },
      "pass_criteria": [
        "Remittance is FIN_REMITTANCE, not FEE_PROCESSING.",
        "Expected payout equals $1,780.00.",
        "No unsupported principal/fee split is produced."
      ]
    },
    {
      "test_id": "QA-004",
      "scenario": "Amazon reserve withholding",
      "input_records": [
        {
          "record_id": "am-sale-004",
          "platform": "amazon",
          "transaction_at": "2026-06-14T00:00:00Z",
          "currency": "USD",
          "source_amount": 10000,
          "source_label": "Product charges",
          "settlement_id": "set-fic-004"
        },
        {
          "record_id": "am-res-004",
          "platform": "amazon",
          "transaction_at": "2026-06-14T00:00:01Z",
          "currency": "USD",
          "source_amount": -1500,
          "source_label": "Account Level Reserve",
          "settlement_id": "set-fic-004"
        },
        {
          "record_id": "am-disb-004",
          "platform": "amazon",
          "transaction_at": "2026-06-15T00:00:00Z",
          "currency": "USD",
          "source_amount": -8500,
          "source_label": "Transfer",
          "settlement_id": "set-fic-004"
        }
      ],
      "expected_classification": [
        {
          "record_ids": [
            "am-sale-004"
          ],
          "taxonomy_code": "REV_GROSS_SALES"
        },
        {
          "record_ids": [
            "am-res-004"
          ],
          "taxonomy_code": "LIQ_RESERVE_HOLD"
        },
        {
          "record_ids": [
            "am-disb-004"
          ],
          "taxonomy_code": "TRF_PAYOUT"
        }
      ],
      "expected_calculations": [
        {
          "calculation_code": "expected_payout",
          "formula": "10000 - 1500",
          "expected_value": 8500,
          "tolerance": 0.01,
          "currency": "USD"
        },
        {
          "calculation_code": "reserve_exposure_ratio",
          "formula": "1500 / 10000",
          "expected_value": 0.15,
          "tolerance": 1e-06
        }
      ],
      "expected_reconciliation_status": "partial",
      "expected_confidence": "Medium",
      "expected_warnings": [
        "Reserve release timing is not supplied.",
        "A reserve is a liquidity restriction, not automatically an expense."
      ],
      "expected_user_facing_response": "The $1,500 account-level reserve explains the $8,500 disbursement and represents 15.00% of gross sales in scope. Release timing remains unresolved.",
      "expected_escalation": {
        "required": true,
        "reason": "Reserve terms and release timing require verification.",
        "target_role": "finance operator"
      },
      "pass_criteria": [
        "Reserve is not classified as a fee.",
        "Expected disbursement equals $8,500.00.",
        "Reserve exposure equals 15.00%."
      ]
    },
