{
  "metadata": {
    "title": "AI Platform Fee Audit Copilot QA Test Cases",
    "filename": "qa-test-cases.json",
    "version": "1.0.0",
    "status": "production-ready",
    "last_updated": "2026-07-27",
    "purpose": "Fictional regression tests for classification, calculations, reconciliation, missing-data handling, duplicate detection, multi-currency logic, reserves, refunds, disputes, and timing.",
    "related_files": [
      "master-transaction-schema.json",
      "normalized-platform-fee-taxonomy.yaml",
      "reconciliation-and-calculation-rules.md",
      "output-schema.json",
      "shopify-payout-reconciliation-guide.md",
      "amazon-settlement-analyzer-guide.md",
      "stripe-fee-calculation-guide.md"
    ]
  },
  "conventions": {
    "fictional_data_only": true,
    "default_example_currency": "USD",
    "date_standard": "ISO 8601",
    "ratio_storage": "Decimal ratio; 0.20 means 20%.",
    "amount_sign": "Source amounts preserve source sign; expected calculations use the stated formula.",
    "tolerance": "Currency calculations default to ±0.01 unless a case specifies otherwise.",
    "null_rule": "null means unavailable, unsupported, or not applicable; zero means verified zero.",
    "priority_order": [
      "payout_reconciliation",
      "fee_leakage",
      "sku_contribution_margin",
      "cash_timing_diagnosis"
    ],
    "automatic_data_gap_triggers": [
      "Missing blocking settlement or payout evidence",
      "More than 20% of in-scope value remains unclassified",
      "Date ranges do not materially overlap",
      "Currency cannot be determined",
      "Required core fields prevent reliable calculations"
    ]
  },
  "allowed_values": {
    "reconciliation_status": [
      "not_started",
      "partial",
      "matched",
      "matched_with_timing_difference",
      "unmatched",
      "data_gap",
      "human_review_required"
    ],
    "confidence": [
      "High",
      "Medium",
      "Low",
      "Unable to Determine"
    ],
    "taxonomy_codes": [
      "ADJ_MANUAL",
      "FEE_ADVERTISING",
      "FEE_FBA",
      "FEE_FX",
      "FEE_INSTANT_PAYOUT",
      "FEE_INTERNATIONAL",
      "FEE_MARKETPLACE",
      "FEE_PROCESSING",
      "FEE_REFERRAL",
      "FEE_SHIPPING_LABEL",
      "FEE_STORAGE",
      "FEE_SUBSCRIPTION",
      "FIN_LOAN_DEDUCTION",
      "FIN_REMITTANCE",
      "LIQ_HOLD",
      "LIQ_RESERVE_HOLD",
      "LIQ_RESERVE_RELEASE",
      "OPS_RETURN",
      "PASS_DUTY",
      "PASS_TAX",
      "PASS_WITHHOLDING",
      "REC_CREDIT",
      "REC_REIMBURSEMENT",
      "REV_DISCOUNT",
      "REV_GROSS_SALES",
      "REV_REFUND",
      "REV_SHIPPING_INCOME",
      "REV_TIPS",
      "RISK_CHARGEBACK",
      "RISK_DISPUTE",
      "TIMING_DIFFERENCE",
