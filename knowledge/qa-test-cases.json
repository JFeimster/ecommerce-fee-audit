    {
      "test_id": "QA-007",
      "scenario": "Stripe international transaction",
      "input_records": [
        {
          "record_id": "st-charge-007",
          "platform": "stripe",
          "transaction_at": "2026-06-08T14:00:00Z",
          "currency": "USD",
          "source_amount": 100,
          "source_label": "charge",
          "balance_transaction_id": "txn-fic-007"
        },
        {
          "record_id": "st-fee-007a",
          "platform": "stripe",
          "transaction_at": "2026-06-08T14:00:01Z",
          "currency": "USD",
          "source_amount": -2.9,
          "source_label": "Stripe processing fee",
          "balance_transaction_id": "txn-fic-007"
        },
        {
          "record_id": "st-fee-007b",
          "platform": "stripe",
          "transaction_at": "2026-06-08T14:00:02Z",
          "currency": "USD",
          "source_amount": -1.5,
          "source_label": "International card fee",
          "balance_transaction_id": "txn-fic-007"
        }
      ],
      "expected_classification": [
        {
          "record_ids": [
            "st-charge-007"
          ],
          "taxonomy_code": "REV_GROSS_SALES"
        },
        {
          "record_ids": [
            "st-fee-007a"
          ],
          "taxonomy_code": "FEE_PROCESSING"
        },
        {
          "record_ids": [
            "st-fee-007b"
          ],
          "taxonomy_code": "FEE_INTERNATIONAL"
        }
      ],
      "expected_calculations": [
        {
          "calculation_code": "net_balance",
          "formula": "100 - 2.90 - 1.50",
          "expected_value": 95.6,
          "tolerance": 0.01,
          "currency": "USD"
        },
        {
          "calculation_code": "effective_fee_rate",
          "formula": "(2.90 + 1.50) / 100",
          "expected_value": 0.044,
          "tolerance": 1e-06
        }
      ],
      "expected_reconciliation_status": "matched",
      "expected_confidence": "High",
      "expected_warnings": [],
      "expected_user_facing_response": "The $100 charge produces a $95.60 net balance after $2.90 in processing fees and $1.50 in international fees, for a 4.40% effective fee rate.",
      "expected_escalation": {
        "required": false,
        "reason": null,
        "target_role": null
      },
      "pass_criteria": [
        "Net balance equals $95.60.",
        "International fee remains distinct from processing fee.",
        "Effective fee rate equals 4.40%."
      ]
    },
