  "x-metadata": {
    "filename": "master-transaction-schema.json",
    "version": "1.0.0",
    "status": "production-ready",
    "last_updated": "2026-07-27",
    "default_example_currency": "USD",
    "date_standard": "ISO 8601",
    "currency_standard": "ISO 4217",
    "related_files": [
