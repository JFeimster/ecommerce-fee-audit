      "description": "Globally unique normalized record identifier.",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "parent_transaction_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Parent normalized event for component or lifecycle records."
    },
    "source_system": {
