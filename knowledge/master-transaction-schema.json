    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_label": {
            "const": "assumption"
          }
        }
      },
      "then": {
        "required": [
          "assumption_note"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "match_method": {
            "enum": [
              "exact_id",
              "exact_amount_date",
              "one_to_many",
              "many_to_one",
              "fx_adjusted",
              "manual"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "matched_record_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": {
            "const": "bank"
          }
        }
      },
      "then": {
        "required": [
          "bank_transaction_id",
          "bank_posted_date",
          "bank_currency"
        ]
      }
    }
  ],
  "x-business-rules": {
    "null_handling": [
      "null means unknown, unavailable, or not applicable; never coerce it to zero.",
      "zero means a confirmed numeric zero.",
      "Missing required financial fields trigger validation failure or a Data Gap Report."
    ],
    "sign_conventions": [
      "source_amount preserves the original source sign.",
      "normalized_amount is positive when merchant economic value or cash increases and negative when it decreases.",
      "Component cost fields are non-negative magnitudes.",
      "Payout is negative at platform balance and matching bank deposit is positive at bank; neither is revenue.",
      "Reserve hold reduces available cash and reserve release increases it; neither is automatically margin."
    ],
    "rounding_rules": [
      "Preserve source precision.",
      "Use decimal arithmetic in production.",
      "Calculate with at least four decimal places or platform-native precision.",
      "Round only presentation values using the currency minor unit."
    ],
    "duplicate_fingerprint_default": "SHA-256 of normalized source_system|source_account_id|source_record_id|transaction_at|transaction_currency|source_amount|source_transaction_type|order_id|settlement_id|payout_id.",
    "validation_rules": [
      "Currency is required for monetary records.",
      "Exchange rate, quote direction, and source are required when currencies differ and amounts are compared.",
      "Tax, duty, material unclassified, financing split, ambiguous reserve, dispute, and unsupported mappings require human review.",
      "A record cannot be marked matched when unexplained variance exceeds approved materiality."
    ]
  },
